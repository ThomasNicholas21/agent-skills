# Agent Skills Environment Variables Example
# Copy or export these variables in your shell environment (~/.bashrc, ~/.zshrc, or local .env)

# Django Core
DJANGO_SECRET_KEY=django-insecure-agent-skills-secret-key-development-mode-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api,0.0.0.0

# Database (PostgreSQL / PostGIS)
USE_POSTGRES=True
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DB_ENGINE=django.contrib.gis.db.backends.postgis

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
TZ=America/Sao_Paulo

# AI / API Keys
GEMINI_API_KEY=

# Path to global Google Antigravity directory
GEMINI_DIR=

# Path to global Claude Code directory
CLAUDE_DIR=

# Path to central Obsidian Second Brain vault
OBSIDIAN_VAULT_DIR=
SECOND_BRAIN_DIR=

# Path to Agent Skills repository hub
AGENT_SKILLS_DIR=

# Path to Daily
DAILIES_DIR=
